# Backend — copia este archivo como .env y completa los valores
# NUNCA commitear .env con credenciales reales

# JWT para tokens propios de la API (puede ser cualquier string largo y aleatorio)
JWT_SECRET=cambia-este-secreto-en-produccion

# Supabase — Project Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key-de-supabase

# URL pública del frontend — usada para armar el link de redirect en los
# correos de invitación de Supabase (debe estar en Auth > URL Configuration >
# Redirect URLs del proyecto de Supabase)
FRONTEND_URL=http://localhost:5173

# Pagos: "mock" (default, sin credenciales) o "stripe"
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_...
